pipeline {
    agent any

    environment {
        IMAGE_NAME = 'chanduyadav143/jmetertest:v1.0'
        REPO_SSH  = 'git@github.com:chanduyadav143/JMeter-Scripts.git'
    }

    stages {
        stage('Checkout Tests (SSH)') {
            steps {
                // Use SSH URL + credentialsId of SSH private key stored in Jenkins
                checkout([$class: 'GitSCM',
                          branches: [[name: 'main']],
                          userRemoteConfigs: [[
                             url: REPO_SSH,
                             credentialsId: 'Git_SSH'
                          ]]
                ])
            }
        }

        stage('Run JMeter Tests') {
            steps {
                bat """
                docker run --rm -v %cd%\\JMX_Files:/tests -w /tests ${IMAGE_NAME} ^
                -n -t Sample.jmx -l results.jtl
                """
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'JMX_Files/results.jtl, report/**', allowEmptyArchive: true
            }
        }

        stage('Push Results to GitHub (SSH)') {
            steps {
                sshagent(['Git_SSH']) {
                    bat """
                    git config --global user.email "chandu143.cy@gmail.com"
                    git config --global user.name  "chanduyadav143"

                    git pull origin main

                    copy /Y JMX_Files\\results.jtl results.jtl
                    xcopy /E /I /Y report report

                    git add .
                    git commit -m "Automated: Add latest JMeter results" || echo Nothing to commit

                    git push origin main
                    """
                }
            }
        }
    }
}
