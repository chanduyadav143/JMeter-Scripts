pipeline {
    agent any

    environment {
        IMAGE_NAME = 'chanduyadav143/jmetertest:v1.0'  // Your Docker image name
        TEST_REPO = 'https://github.com/chanduyadav143/JMeter-Scripts.git'  // Your GitHub repo URL
        BRANCH_NAME = 'main' // branch to push back to
    }

    stages {
        stage('Checkout Tests') {
            steps {
                // Clone your test scripts repository with credentials
                git branch: "${env.BRANCH_NAME}", credentialsId: "${params.gitCredentialsID}", url: "${env.TEST_REPO}"
            }
        }
        
        stage('Run JMeter Tests') {
            steps {
                // Use bat instead of sh and adjust volume mount for Windows PowerShell syntax
                bat """
                docker run --rm -v %cd%\\JMX_Files:/tests -w /tests ${IMAGE_NAME} ^
                -n -t Sample.jmx -l results.jtl
                """
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'JMX_Files/results.jtl, report/**', allowEmptyArchive: true
            }
        }

        stage('Push Results') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${params.gitCredentialsID}", 
                                    usernameVariable: 'chanduyadav143', 
                                    passwordVariable: '${params.gitCredentialsID}')]) {
                    bat '''
                        git config user.email "chandu143.cy@gmail.com"
                        git config user.name "chanduyadav143"
                        
                        git add JMX_Files/results.jtl || echo "results.jtl not found"
                       
                        
                        git commit -m "Add test results from Jenkins build ${BUILD_NUMBER}" || echo "No changes to commit"
                        
                        git push https://%GIT_USERNAME%:%GIT_PASSWORD%@github.com/chanduyadav143/JMeter-Scripts.git ${BRANCH_NAME}
                    '''
                }
            }
        }
    }
}
