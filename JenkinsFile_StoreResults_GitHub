pipeline {
    agent any

    environment {
        IMAGE_NAME = 'chanduyadav143/jmetertest:v1.0'
        TEST_REPO = 'https://github.com/chanduyadav143/JMeter-Scripts.git'
    }

    stages {

        stage('Checkout Tests') {
            steps {
                // Use HTTPS + PAT credentials
                git branch: 'main',
                    credentialsId: 'ChanduJMeter',  // Add your PAT here in Jenkins Credentials
                    url: TEST_REPO
            }
        }

        stage('Run JMeter Tests') {
            steps {
                bat """
                docker run --rm -v %cd%\\JMX_Files:/tests -w /tests ${IMAGE_NAME} ^
                -n -t Sample.jmx -l results.jtl
                """
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'JMX_Files/results.jtl, report/**', allowEmptyArchive: true
            }
        }

        stage('Push Results to GitHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ChanduJMeter', // Use same PAT credentials
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {

                    bat """
                    git config --global user.email "Chandu143.cy@gmail.com"
                    git config --global user.name "chanduyadav143"

                    copy /Y JMX_Files\\results.jtl results.jtl
                    xcopy /E /I /Y report report

                    git add results.jtl report

                    git commit -m "Automated: Add latest JMeter results" || echo Nothing to commit

                    git remote set-url origin https://%GIT_USER%:%GIT_PASS%@github.com/chanduyadav143/JMeter-Scripts.git

                    git push origin main
                    """
                }
            }
        }

    }
}
